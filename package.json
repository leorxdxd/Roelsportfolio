{
  "name": "roel-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "build:gh": "tsc --noEmit && vite build --base=/Roelsportfolio/ && node scripts/spa-fallback.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "media:placeholders": "node scripts/generate-placeholders.mjs",
    "media:optimize": "node scripts/optimize-images.mjs",
    "media:brand": "node scripts/generate-brand-assets.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "sass": "^1.108.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": "22.x"
  }
}
